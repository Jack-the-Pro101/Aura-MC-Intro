{
  "schemaVersion": 1,
  "id": "titlescreen",
  "version": "${version}",
  "name": "Titlescreen",
  "description": "Replaces the vanilla loading/title screen presentation with a configurable video intro. One baked clip can cover the whole start-up: it plays behind the loading bar, freezes on a chosen frame while the game finishes loading, then continues as the intro while the progress bar, the buttons and the title screen texts fade in on their own timestamps.",
  "authors": [
    "bluegaria"
  ],
  "contact": {},
  "license": "GPL-3.0-only",
  "environment": "client",
  "icon": "assets/titlescreen/icon.png",
  "entrypoints": {
    "preLaunch": [
      "net.bluegaria.titlescreen.client.TitlescreenPreLaunch"
    ],
    "client": [
      "net.bluegaria.titlescreen.client.TitlescreenClient"
    ],
    "modmenu": [
      "net.bluegaria.titlescreen.client.TitlescreenModMenu"
    ]
  },
  "mixins": [
    {
      "config": "titlescreen.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "titlescreen.versioned.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "cloth-config": "${cloth_config_dependency}"
  },
  "suggests": {
    "modmenu": "${modmenu_dependency}"
  }
}
